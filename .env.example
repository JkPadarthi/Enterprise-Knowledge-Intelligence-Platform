# ─────────────────────────────────────────────────────────────────────────────
# GraphRAG Engine — environment configuration
# Copy to `.env` and adjust. All values have safe local defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider (provider-agnostic; OpenRouter is the default backend) ──────
# One of: openrouter | ollama | mock
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Model IDs are resolved THROUGH OpenRouter (never the hardcoded Gemini SDK).
# Swap freely for any OpenRouter-compatible slug.
WORKER_MODEL=google/gemini-flash-1.5
QA_MODEL=google/gemini-pro-1.5
# Offline fallback backend
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings (local Sentence-Transformers, no API cost) ────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Knowledge graph (Neo4j) ──────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Vector store (ChromaDB) ──────────────────────────────────────────────────
# Persistent embedded mode (no extra container) unless CHROMA_HOST is set.
CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Text chunking ────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Translation (conditional: translate only when language != target) ────────
TRANSLATE_TARGET_LANG=en

# ── NLP models (pretrained / zero-shot; no training required) ────────────────
CLASSIFIER_MODEL=facebook/bart-large-mnli
DOC_TYPE_LABELS=report,invoice,contract,email,article,legal,technical,other
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
GLINER_MODEL=urchade/gliner_large-v1.1
NER_LABELS=PERSON,ORGANIZATION,LOCATION,DATE,MONEY,PRODUCT,EVENT

# ── Runtime ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
APP_HOST=0.0.0.0
APP_PORT=8000
